// Ganpati Lifecare - Prisma Database Schema
// Orthopedic, Surgical & Hospital Supplies

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  description          String
  category             String
  imageUrls            String   // JSON stringified array or primary image URL
  specifications       String?  // JSON stringified key-values
  variants             String?  // JSON stringified variants array
  packagingInformation String?
  seoTitle             String?
  seoDescription       String?
  isFeatured           Boolean  @default(false)
  isPublished          Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isFeatured])
  @@index([isPublished])
}

model Inquiry {
  id           Int      @id @default(autoincrement())
  inquiry_id   String   @unique
  customerName String
  phone        String
  email        String?
  productName  String?
  quantity     String?  @default("1")
  message      String?
  inquiryType  String   @default("Website")
  status       String   @default("New")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([phone])
  @@index([createdAt])
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  coverImage     String?
  author         String    @default("Ganpati Lifecare Team")
  publishedAt    DateTime? @default(now())
  updatedAt      DateTime  @updatedAt
  isPublished    Boolean   @default(true)
  seoTitle       String?
  seoDescription String?

  @@index([slug])
  @@index([isPublished])
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())

  @@index([email])
}

model ServiceLocation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  address     String?
  isPublished Boolean  @default(true)

  @@index([slug])
}

model SiteSettings {
  id              Int      @id @default(1)
  businessName    String   @default("Ganpati Lifecare")
  logoUrl         String   @default("/logo.svg")
  contactPhone    String   @default("+91 98282 32254")
  alternatePhone  String   @default("+91 94600 95250")
  contactEmail    String   @default("whiteroseglc@gmail.com")
  businessAddress String   @default("Main Road, Mandi Goluwala, District Hanumangarh, Rajasthan, India — 335802")
  gstin           String   @default("08JPEPD8830M1ZD")
  whatsappNumber  String   @default("+91 98282 32254")
  seoDefaults     String?  // JSON stringified default meta
  updatedAt       DateTime @updatedAt
}
